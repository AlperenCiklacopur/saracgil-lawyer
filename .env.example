# Melda Saraçgil Hukuk & Danışmanlık - Ortam Değişkenleri

# Yönetici Giriş Bilgileri (Varsayılan değerler)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=saracgil2026!
SESSION_SECRET=saracgil-secret-key-super-secure-2026-lawyer-token

# E-Posta Bildirim Servisi (Resend - resend.com üzerinden ücretsiz API Key)
# Boş bırakıldığında form verileri admin paneline kaydedilir, e-posta konsolda simüle edilir.
# Gerçek mail gönderimi için resend.com'dan ücretsiz aldığınız re_... anahtarını giriniz:
RESEND_API_KEY=
NOTIFICATION_EMAIL=saracgilhukuk@gmail.com
RESEND_FROM_EMAIL=Melda Saraçgil Hukuk <onboarding@resend.dev>

# Vercel Deployment & Veri Depolama (Opsiyonel / Tavsiye Edilen)
# Vercel paneli üzerinden "Storage -> Upstash Redis" eklediğinizde bu iki değişken otomatik atanır:
# UPSTASH_REDIS_REST_URL=https://...
# UPSTASH_REDIS_REST_TOKEN=...
